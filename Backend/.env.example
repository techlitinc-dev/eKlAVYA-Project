# ============================================================================
# MENTOR AI BACKEND - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual values
# After copying: cp .env.example .env

# ============================================================================
# GEMINI API CONFIGURATION (Required)
# ============================================================================

# Gemini API Key - Get from: https://makersuite.google.com/app/apikey
# This is the PRIMARY API used for all AI features
GOOGLE_API_KEY=your_gemini_api_key_here

# Model override (optional). Default is gemini-2.5-flash-lite (cheapest tier),
# but it is gated for newer API keys ("no longer available to new users").
# If you get a 404 on AI calls, set an available model, e.g.:
# GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite

# ============================================================================
# FIREBASE CONFIGURATION (Required)
# ============================================================================

# Path to Firebase service account credentials JSON file
# Download from: Firebase Console > Project Settings > Service Accounts
FIREBASE_CREDENTIALS_PATH=config/firebase-credentials.json

# Firebase project configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Web API Key (for password verification)
# Get from: Firebase Console > Project Settings > General > Your apps > Web API Key
FIREBASE_API_KEY=your_firebase_web_api_key_here

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Server configuration
HOST=0.0.0.0
PORT=8000

# CORS origins (comma-separated, no spaces)
# Add your frontend URLs here
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# OPTIMIZATION SETTINGS (Optional - for cost reduction)
# ============================================================================

# Force Gemini API for all searches (disable local search optimization)
# Set to 'true' only for testing/debugging
# Default: false (uses optimized local search first)
FORCE_GEMINI_SEARCH=false

# Minimum results from local search before falling back to Gemini
# Lower = more local searches (cheaper), Higher = more Gemini calls (better quality)
# Default: 3
LOCAL_SEARCH_MIN_RESULTS=3

# Enable detailed search method logging (shows which method was used)
# Default: true
LOG_SEARCH_METHOD=true

# Cache TTL in minutes (how long to cache search results)
# Default: 30 minutes
SEARCH_CACHE_TTL_MINUTES=30

# Maximum cache size (number of cached entries)
# Default: 1000
SEARCH_CACHE_MAX_SIZE=1000

# ============================================================================
# TESTING/DEVELOPMENT (Optional)
# ============================================================================

# Use mock services (no API calls, for testing)
# Default: false
USE_MOCK_SERVICES=false

# Bypass authentication (for testing only, NEVER use in production)
# Default: false
TESTING_MODE=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/app.log

# ============================================================================
# RATE LIMITING (Optional)
# ============================================================================

# Maximum search requests per minute per user
# Default: 50
RATE_LIMIT_SEARCH=50

# Maximum embedding requests per minute per user
# Default: 100
RATE_LIMIT_EMBEDDING=100

# Rate limit window in seconds
# Default: 60
RATE_LIMIT_WINDOW=60

# ============================================================================
# JWT AUTHENTICATION (Required for production)
# ============================================================================

# JWT secret key - Generate with: openssl rand -hex 32
# IMPORTANT: Keep this secret and never commit to version control
JWT_SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32

# JWT algorithm
# Default: HS256
JWT_ALGORITHM=HS256

# Access token expiry (in minutes)
# Default: 30 minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiry (in days)
# Default: 7 days
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# HERMES AI MENTOR (Optional - defaults work out of the box)
# ============================================================================

# LLM for the Hermes mentor. Defaults to gemini-2.5-flash-lite via the shared
# GeminiClient (cheapest Gemini: $0.10/M input, $0.40/M output, Oct 2026).
# Override the model name only if you know what you're doing.
HERMES_MODEL=gemini-2.5-flash-lite

# Mock mode: canned mentor responses with ZERO Gemini calls (dev/testing)
# Default: false
HERMES_MOCK=false

# Max mentor chat turns per student per day (cost control)
# Default: 50
HERMES_DAILY_CHAT_CAP=50

# Quiz score (%) at or above which an attempt counts as passed
# Default: 70
HERMES_MASTERY_THRESHOLD=70

# Compress session history into rolling memory after this many turns
# Default: 10
HERMES_MEMORY_ROLLUP_TURNS=10

# Max output tokens for a mentor reply / daily summary
# Defaults: 600 / 700
HERMES_CHAT_MAX_TOKENS=600
HERMES_SUMMARY_MAX_TOKENS=700

# ============================================================================
# GOOGLE CLOUD (Optional - only if using Vertex AI features)
# ============================================================================
# NOTE: These are NOT required for the optimized version
# The system now uses Gemini API directly instead of Vertex AI

# Google Cloud Project ID (optional)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Google Cloud Region (optional)
GOOGLE_CLOUD_REGION=us-central1

# Path to Google Cloud service account JSON file (optional)
GOOGLE_APPLICATION_CREDENTIALS=path/to/gcp-service-account.json

# ============================================================================
# MONITORING & ANALYTICS (Optional)
# ============================================================================

# Sentry DSN for error tracking (optional)
SENTRY_DSN=your_sentry_dsn_here

# Google Analytics tracking ID (optional)
GA_TRACKING_ID=UA-XXXXXXXXX-X

# Enable performance monitoring
ENABLE_PERFORMANCE_MONITORING=false

# ============================================================================
# PAYMENT INTEGRATION (Optional)
# ============================================================================

# Razorpay API credentials (for payment processing)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================

# SMTP settings for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Mentor AI

# ============================================================================
# NOTES
# ============================================================================
# 
# REQUIRED for basic operation:
# - GOOGLE_API_KEY (Gemini API)
# - FIREBASE_CREDENTIALS_PATH
# - FIREBASE_PROJECT_ID
# - JWT_SECRET_KEY (for production)
#
# OPTIONAL for optimization:
# - FORCE_GEMINI_SEARCH (default: false)
# - LOCAL_SEARCH_MIN_RESULTS (default: 3)
# - SEARCH_CACHE_TTL_MINUTES (default: 30)
#
# OPTIONAL for testing:
# - USE_MOCK_SERVICES (default: false)
# - TESTING_MODE (default: false)
#
# NOT REQUIRED (legacy):
# - GOOGLE_CLOUD_PROJECT
# - GOOGLE_APPLICATION_CREDENTIALS
# - Vertex AI settings
#
# ============================================================================
