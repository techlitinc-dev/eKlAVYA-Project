      "ncertPages": "Class 12, pp. 255-261",
      "statementHtml": "<p>Find the number of unpaired electrons in the low-spin octahedral complex $[\\text{Fe}(\\text{CN})_6]^{4-}$ (Atomic number of $\\text{Fe} = 26$).</p>",
      "options": [],
      "correctOption": null,
